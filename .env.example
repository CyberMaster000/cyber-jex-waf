# Copy to .env and change EVERY value before deploying.
# Detection API
WAF_API_KEY_1=waf-key-dev-001
WAF_API_KEY_2=waf-key-dev-002

# Admin / Retraining API
WAF_ADMIN_KEY_1=waf-admin-key-001

# Dashboard HTTP Basic credentials (MUST change)
WAF_DASH_USER=sentinel
WAF_DASH_PASSWORD=change-me

# Gateway / inline enforcement
WAF_BACKEND_URL=http://sample-app-1:5001
WAF_RATE_LIMIT=100
WAF_RATE_WINDOW=60
WAF_MAX_BODY_BYTES=1048576

# Redis (must match redis auth)
REDIS_PASSWORD=change-me
WAF_REDIS_URL=redis://:change-me@redis:6379/0

# Observability
WAF_METRICS_TOKEN=change-me
WAF_LOG_LEVEL=INFO
WAF_LOG_JSON=false

# Optional CIDR lists, comma separated (empty = disabled)
WAF_IP_ALLOWLIST=
WAF_IP_BLOCKLIST=

# Host ports for nginx (change if 80/443 are already in use)
WAF_HTTP_PORT=80
WAF_HTTPS_PORT=443
